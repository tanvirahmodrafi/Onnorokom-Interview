# Used only when running the backend locally with `dotnet run`. Docker Compose sets its own values.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=school_admission;Username=postgres;Password=postgres
# Frontend origin(s) allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:5173
HOLD_DURATION_SECONDS=600
# Load protection (defaults shown; 0 turns a per-IP limit off)
# RATE_LIMIT_PER_MINUTE=600
# APPLY_RATE_LIMIT_PER_MINUTE=30
# MAX_CONCURRENT_REQUESTS=32
# MAX_QUEUED_REQUESTS=500
